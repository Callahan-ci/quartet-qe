#!/usr/bin/env bash
# Runs Quartet QE for this tests repo. Try: ./quartet-qe doctor
# Quartet is installed once per machine (see ./get-started.sh in your Quartet QE folder), not inside this repo.
cd "$(dirname "$0")"
QUARTET="${QUARTET_HOME:-$HOME/.quartet/current}"
if [ ! -x "$QUARTET/bin/quartet-qe" ]; then
  echo "Quartet QE is not installed on this machine (looked in $QUARTET)." >&2
  echo "Clone Quartet QE and run ./get-started.sh there, or set QUARTET_HOME." >&2
  exit 1
fi
exec "$QUARTET/bin/quartet-qe" "$@"
