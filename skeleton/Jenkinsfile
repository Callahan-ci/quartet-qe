// Point a Jenkins multibranch pipeline or organisation folder at this repo and it will find this file.
// Every branch and pull request then gets its own job, with nothing to create by hand.
pipeline {
    agent any
    options { timestamps() }
    parameters {
        string(name: 'STORY', defaultValue: '', description: 'Optional. A story to write tests for, such as jira:SHOP-142 or stories/SHOP-142.md')
    }
    stages {
        stage('Framework') {
            steps { sh 'git submodule update --init' }
        }
        stage('Write tests for a story') {
            when { expression { params.STORY?.trim() } }
            environment {
                AI_PROVIDER = 'anthropic'
                AI_API_KEY = credentials('quartet-ai-key')
            }
            // The story is passed through the environment so its text can never be run as a shell command.
            steps { sh './quartet-qe run --story "$STORY"' }
        }
        stage('Run tests without AI') {
            // Replay uses only reviewed recordings, so this gate needs no AI key and costs nothing.
            environment { QUARTET_MODE = 'replay' }
            steps { sh './gradlew test --console=plain' }
        }
    }
    post {
        always {
            junit allowEmptyResults: true, testResults: 'build/test-results/test/*.xml'
            archiveArtifacts allowEmptyArchive: true, artifacts: 'reports/**, build/quartet-report/**'
        }
    }
}
