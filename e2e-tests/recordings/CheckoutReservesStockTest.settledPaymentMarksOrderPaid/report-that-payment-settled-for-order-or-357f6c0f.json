{
  "instruction" : "Report that payment settled for order {{orderId}}",
  "why" : "Settlement is how the order learns it has been paid",
  "model" : "scripted",
  "summary" : "Payment reported.",
  "on" : [ "order-events" ],
  "steps" : [ {
    "tool" : "kafka_generate",
    "check" : "published:1",
    "args" : {
      "topic" : "shop.payments.settled",
      "keyField" : "orderId",
      "overrides" : {
        "orderId" : "${vars.orderId}",
        "status" : "SETTLED"
      }
    }
  } ],
  "data" : {
    "published" : "${steps.0.published}"
  }
}
