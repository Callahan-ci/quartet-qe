# Pick one AI. The key is the only thing a team has to provide.
# AI_PROVIDER: anthropic | openai | azure-openai | gemini | openai-compatible
AI_PROVIDER=anthropic
AI_API_KEY=
# Required except for anthropic, which defaults to claude-opus-5-5.
AI_MODEL=
# Required for azure-openai and openai-compatible (Ollama, vLLM, LiteLLM, internal gateways).
AI_BASE_URL=

# auto: replay, then AI when needed. replay: never call AI to act (CI gate). live: always call AI.
QUARTET_MODE=auto
QUARTET_ENV=../context/environments/demo.yaml
